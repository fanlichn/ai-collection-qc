# Change every password/secret before starting
ADMIN_USER=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_SECRET
MYSQL_PASSWORD=REPLACE_WITH_DB_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_ROOT_PASSWORD
DATABASE_URL=mysql+pymysql://qc:REPLACE_WITH_DB_PASSWORD@mysql:3306/collection_qc?charset=utf8mb4

# Existing Auto.js APK OSS configuration (server-side credentials only)
OSS_ENDPOINT=https://s3.oss-ap-southeast-1.aliyuncs.com
OSS_BUCKET=lak-audio
OSS_ACCESS_KEY_ID=YOUR_RAM_ACCESS_KEY_ID
OSS_ACCESS_KEY_SECRET=YOUR_RAM_ACCESS_KEY_SECRET
OSS_PREFIX=
OSS_SCAN_INTERVAL=60
OSS_START_AFTER=

# T4 GPU ASR. Start with small for first smoke test; try medium after accuracy review.
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_BEAM_SIZE=5
WHISPER_LANGUAGE=
MAX_AUDIO_MB=200
AUDIO_TMP_DIR=/data/audio
WORKER_POLL_SECONDS=10

# Optional OpenAI-compatible LLM endpoint. Empty = deterministic rule-screening only.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
